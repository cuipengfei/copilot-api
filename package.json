{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jeffreycao/copilot-api",
  "version": "2.6.1",
  "description": "GitHub Copilot, OpenAI Codex, OpenCode Go, and third-party AI provider gateway with OpenAI and Anthropic API compatibility.",
  "keywords": [
    "github-copilot",
    "codex",
    "ai-gateway",
    "opencode",
    "anthropic-compatible"
  ],
  "homepage": "https://github.com/caozhiyuan/copilot-api",
  "bugs": "https://github.com/caozhiyuan/copilot-api/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/caozhiyuan/copilot-api"
  },
  "license": "MIT",
  "author": "caozhiyuan",
  "type": "module",
  "bin": {
    "copilot-api": "./dist/main.js"
  },
  "files": [
    "dist",
    "pages"
  ],
  "scripts": {
    "build": "tsdown",
    "build:desktop": "tsdown --config tsdown.desktop.config.ts",
    "dev": "NODE_USE_SYSTEM_CA=1 bun run --watch ./src/main.ts",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "lint_all(){ eslint . \"$@\" && bun run --cwd desktop lint \"$@\"; }; lint_all",
    "lint:desktop": "bun run --cwd desktop lint",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "release": "bumpp && bun publish --access public",
    "start": "NODE_USE_SYSTEM_CA=1 NODE_ENV=production bun run ./src/main.ts",
    "test": "bun test --isolate",
    "typecheck": "tsc",
    "typecheck:all": "bun run typecheck && bun run --cwd desktop typecheck",
    "typecheck:desktop": "bun run --cwd desktop typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix",
    "desktop/**/*": "eslint --config desktop/eslint.config.mjs --cache --fix"
  },
  "overrides": {
    "@hono/node-server": "^2.1.1",
    "rolldown": "1.2.5"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@clack/prompts": "^1.8.1",
    "@fastify/busboy": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "citty": "^0.2.2",
    "clipboardy": "^5.3.2",
    "consola": "^3.4.2",
    "fetch-event-stream": "^0.1.6",
    "fzstd": "^0.1.1",
    "gpt-tokenizer": "^4.0.0",
    "hono": "^4.13.7",
    "proxy-from-env": "^2.1.0",
    "srvx": "^1.0.4",
    "tiny-invariant": "^1.3.3",
    "undici": "^8.10.2",
    "winreg": "^1.2.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/bun": "^1.4.2",
    "@types/proxy-from-env": "^1.0.4",
    "@types/winreg": "^1.2.36",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
